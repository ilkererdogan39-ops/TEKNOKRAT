# ========================================
# Kurumsal LMS - Ortam Degiskenleri
# ========================================
# Bu dosyayi kopyalayip .env olarak kaydedin
# ve degerlerini kendi ortaminiza gore degistirin
# ========================================

# PostgreSQL Veritabani Baglantisi
# Format: postgresql://kullanici:sifre@host:port/veritabani
DATABASE_URL=postgresql://lmsuser:sifre123@localhost:5432/lms_database

# Oturum Guvenligi Anahtari
# Rastgele uzun bir string olmali (en az 32 karakter)
SESSION_SECRET=buraya-rastgele-uzun-gizli-anahtar-yazin

# Uygulama Portu (varsayilan: 5000)
PORT=5000

# Ortam Tipi (development veya production)
NODE_ENV=production

# ========================================
# Docker Compose icin ek degiskenler
# ========================================

# PostgreSQL sifresi (docker-compose.yml icin)
POSTGRES_PASSWORD=guclu-veritabani-sifresi-123
